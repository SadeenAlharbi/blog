APP_NAME="منصة المعرفة السعودية"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-----------------------------------------------------------------------------
# Database — MySQL, not the Laravel default of SQLite.
#
# Create the schema first, then run: php artisan migrate
#   CREATE DATABASE saudi_blog CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Do NOT switch this to sqlite: the schema relies on MySQL behaviour, and a
# clean install that silently ran on SQLite would look fine until it did not.
#-----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saudi_blog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#-----------------------------------------------------------------------------
# REST API client key (X-API-KEY header)
#
# Identifies the CLIENT APPLICATION, which is a separate concern from Sanctum:
# Sanctum answers "which user is this?", this key answers "which app is this?".
#
# Leave it EMPTY to keep the layer inactive — VerifyApiKey steps aside when no
# key is configured, so a fresh install is not locked out of its own API.
# Setting it turns enforcement on for every /api/v1 route, which means every
# client (including the articles-manager admin panel) must then send the header.
#-----------------------------------------------------------------------------
API_KEY=

#-----------------------------------------------------------------------------
# Google sign-in (Laravel Socialite)
#
# Create the credentials at https://console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID (type: Web application), and register the
# redirect URI below as an "Authorized redirect URI" there.
#
# Never commit the real values: they belong in .env only.
#-----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
